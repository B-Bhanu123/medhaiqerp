
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  role          String
  status        String    @default("ACTIVE")
  firstName     String
  lastName      String
  phoneNumber   String?
  avatarUrl     String?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Student {
  id              String   @id @default(uuid())
  admissionNo     String   @unique
  rollNo          String?  @unique
  firstName       String
  middleName      String?
  lastName        String
  gender          String
  dateOfBirth     DateTime
  email           String   @unique
  phone           String?
  address         String
  bloodGroup      String?
  nationalId      String?
  admissionDate   DateTime
  academicYear    String
  programId       String
  currentSemester Int      @default(1)
  section         String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Department {
  id                 String   @id @default(uuid())
  code               String   @unique
  name               String
  headOfDepartmentId String?
  buildingLocation   String?
  contactEmail       String
  createdAt          DateTime @default(now())
}

model Course {
  id               String   @id @default(uuid())
  code             String   @unique
  title            String
  departmentId     String
  credits          Int
  lectureHours     Int
  labHours         Int
  isElective       Boolean  @default(false)
  syllabusOverview String
  createdAt        DateTime @default(now())
}

model FeeStructure {
  id           String   @id @default(uuid())
  name         String
  academicYear String
  programId    String
  semester     Int
  totalAmount  Float
  createdAt    DateTime @default(now())
}

model StudentInvoice {
  id             String   @id @default(uuid())
  invoiceNo      String   @unique
  studentId      String
  feeStructureId String
  issueDate      DateTime
  dueDate        DateTime
  subtotal       Float
  discountAmount Float    @default(0)
  fineAmount     Float    @default(0)
  totalAmount    Float
  paidAmount     Float    @default(0)
  balanceAmount  Float
  status         String   @default("ISSUED")
  createdAt      DateTime @default(now())
}

model Employee {
  id             String   @id @default(uuid())
  employeeCode   String   @unique
  firstName      String
  lastName       String
  email          String   @unique
  phone          String
  departmentId   String
  designation    String
  employeeType   String   @default("FULL_TIME")
  joiningDate    DateTime
  baseSalary     Float
  bankAccountNo  String
  bankIfsc       String
  status         String   @default("ACTIVE")
}

model Book {
  id              String   @id @default(uuid())
  isbn            String   @unique
  title           String
  author          String
  publisher       String
  category        String
  totalCopies     Int
  availableCopies Int
  shelfLocation   String
  price           Float
}
